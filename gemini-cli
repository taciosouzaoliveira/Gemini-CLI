#!/usr/bin/env bash
# gemini-cli: pergunte ao Google Gemini direto do terminal.
#   gemini-cli "explique o comando ss -tulpn"
#   cat /var/log/syslog | tail -50 | gemini-cli "resuma os erros"
#
# Requer: curl, jq e a variável GEMINI_API_KEY.
# Opcional: GEMINI_MODEL (padrão abaixo). Veja os modelos da sua chave com:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models | jq -r '.models[].name'
set -euo pipefail

MODEL="${GEMINI_MODEL:-gemini-2.5-flash}"

for dep in curl jq; do
    command -v "$dep" >/dev/null || { echo "Erro: instale '$dep' (sudo apt install $dep)." >&2; exit 1; }
done
[ -n "${GEMINI_API_KEY:-}" ] || { echo "Erro: defina a variável GEMINI_API_KEY." >&2; exit 1; }

TAREFA="$*"
if [ -t 0 ]; then
    PROMPT="$TAREFA"
else
    CONTEXTO="$(cat -)"
    PROMPT="Contexto (fornecido via pipe):
---
${CONTEXTO}
---
Tarefa: ${TAREFA}"
fi

if [ -z "$TAREFA" ]; then
    echo "Uso: gemini-cli \"sua pergunta\"" >&2
    echo "  ou: cat arquivo.txt | gemini-cli \"analise este texto\"" >&2
    exit 1
fi

PAYLOAD="$(jq -n --arg prompt "$PROMPT" '{contents: [{parts: [{text: $prompt}]}]}')"

# A chave vai no cabeçalho, não na URL: assim não aparece na lista de processos (ps) nem em logs.
RESPOSTA="$(curl -sS --fail-with-body \
    -H "Content-Type: application/json" \
    -H "x-goog-api-key: ${GEMINI_API_KEY}" \
    -d "$PAYLOAD" \
    "https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent")" || {
    echo "Erro na chamada à API:" >&2
    echo "$RESPOSTA" | jq -r '.error.message // .' >&2
    exit 1
}

printf '%s\n' "$(echo "$RESPOSTA" | jq -r '.candidates[0].content.parts[0].text // .error.message // "Sem resposta."')"
